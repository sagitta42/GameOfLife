@{
    ViewData["Title"] = "Game Of Life";
}

<div class="text-center">
    <h1>Game Of Life</h1>

    <form method="post" asp-action="LaunchGame">
        <button type="submit" class="btn btn-primary btn-lg">Launch game</button>
    </form>

    @if (ViewBag.Message != null)
    {
        <p>@ViewBag.Message</p>
    }    
</div>