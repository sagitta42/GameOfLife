@{
    ViewData["Title"] = "Launch";
}

<div class="text-center">
    <h1>Game Of Life</h1>

    <h2>Enter cell coordinates:</h2>

    <form method="post" asp-action="RunCycle">
        <button type="submit" class="btn btn-primary btn-lg">Cycle</button>
    </form>    

    @if (ViewBag.Message != null)
    {
                <div class="mt-3 game-console-output" style="white-space: pre;">
            @ViewBag.Message
                </div>
    }    
</div>