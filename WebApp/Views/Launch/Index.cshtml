@{
    ViewData["Title"] = "Launch";
}

<div class="text-center">
    <h2>In the Game of Life you stabilize or you die</h2>

    @if (ViewBag.Message != null)
    {
        <div class="mt-3 game-console-output" style="white-space: pre;">
            @ViewBag.Message
        </div>
    }     
</div>

<form id="autoCycle" method="post" action="@Url.Action("RunCycle", "Launch")">
</form>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        var status = '@ViewBag.Status';
        if (status != "end") {
            setTimeout(function() {
                $('#autoCycle').submit();
            }, 1000);
        }
    });
</script>