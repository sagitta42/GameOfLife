@{
    ViewData["Title"] = "Setup";
}

<div class="text-center">
    <h1>Game Of Life</h1>

    <h2>Enter cell coordinates:</h2>

    <form method="post" asp-action="ToggleCell">
        <input type="number" name="X" class="form-control d-inline-block" style="width: 85px;" placeholder="X" required />
        <span class="mx-2">x</span>
        <input type="number" name="Y" class="form-control d-inline-block" style="width: 85px;" placeholder="Y" required />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary btn-lg">Toggle cell</button>
        </div>
    </form>

    @if (ViewBag.Message != null)
    {
            <div class="mt-3 game-console-output" style="white-space: pre;">
            @ViewBag.Message
            </div>
    }    
</div>