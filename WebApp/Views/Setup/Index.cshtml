@{
    ViewData["Title"] = "Setup";
}

<div class="text-center">
    <h2>Enter cell coordinates:</h2>

    <form method="post" asp-action="ToggleCell">
        <input type="number" name="X" class="form-control d-inline-block" style="width: 85px;" placeholder="X" required />
        <span class="mx-2">x</span>
        <input type="number" name="Y" class="form-control d-inline-block" style="width: 85px;" placeholder="Y" required />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary btn-lg">Toggle cell</button>
        </div>
    </form>

    <form method="post" asp-action="RunGame">
        <div class="mt-3">
            <button type="submit" class="btn btn-primary btn-lg">Run</button>
        </div>
    </form>

    @if (ViewBag.alert == "outOfGrid")
    {
        <div class="popup">
            <span class="popuptext" id="myPopup">Coordinate out of grid!</span>
        </div>
        @* TODO: improve (takes space and changes for each toggle) *@
        <script>
            var popup = document.getElementById("myPopup");
            popup.classList.toggle("show");
            setTimeout(function() {popup.classList.toggle("show");}, 2000);
        </script>
    }     

    @if (ViewBag.Message != null)
    {
        <div class="mt-3 game-console-output" style="white-space: pre;">
            @ViewBag.Message
        </div>
    }    
</div>